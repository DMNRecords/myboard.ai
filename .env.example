# Values that are safe to expose to the browser. Database RLS must still protect data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_ or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI configuration. Do not expose it to the browser or commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
